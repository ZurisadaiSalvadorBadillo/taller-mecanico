flowchart LR
  subgraph Vue[Vue.js]
    Menu[DashboardView]
    Taller[WorkshopRegistrationForm]
    Cliente[ClientRegistrationForm]
    Gestion[ClientManagementView]
    Estatus[UserStatusCatalogView]
    VPIC[NHTSA vPIC API]
    Menu --> Taller & Cliente & Gestion & Estatus
    Gestion --> VPIC
  end
  subgraph RBAC[JWT y RBAC]
    JWT[JwtAuthenticationFilter]
    Guard[SecurityConfig y PreAuthorize]
    JWT --> Guard
  end
  subgraph Spring[Spring Boot API]
    WC[WorkshopController]
    CC[ClientController]
    SC[UserStatusController]
    VC[VehicleController]
    WF[WorkshopRegistrationFacade]
    CF[ClientRegistrationFacade]
    SF[UserStatusService]
    VF[VehicleService]
    WC --> WF
    CC --> CF
    SC --> SF
    VC --> VF
  end
  subgraph Data[MariaDB y archivos]
    W[(talleres)]
    C[(clientes taller_id y status_usuario_id)]
    S[(status_usuario)]
    V[(vehiculos cliente_id)]
    Photos[(uploads)]
  end
  Taller & Cliente & Gestion & Estatus --> JWT
  Guard --> WC & CC & SC & VC
  WF --> W & Photos
  CF --> C & W & S & Photos
  SF --> S
  VF --> V & C
  Guard -. ADMINISTRADOR y SECRETARIA .-> WC
  Guard -. ADMINISTRADOR y SECRETARIA .-> CC
  Guard -. solo ADMINISTRADOR .-> SC
  Guard -. solo ADMINISTRADOR suspende .-> CC
